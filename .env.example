# Copy to .env, choose different long random passwords. Do not commit .env.
POSTGRES_PASSWORD=replace-with-unique-database-password
MEMBER1_PASSWORD=replace-with-member-one-password
MEMBER2_PASSWORD=replace-with-member-two-password
APP_ORIGIN=http://127.0.0.1:1420
# Required in production when using Cloudflare Access to limit app access.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-app-audience-tag
CF_ACCESS_ALLOWED_EMAILS=person-one@example.com,person-two@example.com
# AGE_RECIPIENT=age1... (public recipient only, optional backup profile)
